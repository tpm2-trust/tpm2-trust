#!/usr/bin/env bash
# pin: the pins between the projects of this workspace.
#
# Each project is edited in its checkout here (assh/, tpm2-kira/, ...). A
# project that uses another pins a commit of it - a submodule, or a line in
# a file - and builds its releases from exactly that commit; go.work lets
# development builds use the checkouts instead. This script shows where the
# pins stand and moves them to a checkout's HEAD. It stages; committing is
# the project's own step.
#
#   ./pin status        every pin, against the checkout it pins
#   ./pin assh          tpm2-kira/assh and safearch/assh to assh's HEAD
#   ./pin tpm2-kira     marify's core.properties and the vault's submodule
#                       tpm2-kira/ (its core) to tpm2-kira's HEAD
#   ./pin tpm2-verifier tpm2-kira/tpm2-verifier (the core's EK root store)
#                       to tpm2-verifier's HEAD
#
# go-tpm is pinned in go.mod (tpm2-kira's version, assh's replace) by intent
# and is shown, not moved.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The submodules that pin a checkout of this workspace: "consumer path checkout".
SUBMODULES=(
    "tpm2-kira assh assh"
    "safearch assh assh"
    "tpm2-kira-vault tpm2-kira tpm2-kira"
    "tpm2-kira tpm2-verifier tpm2-verifier"
)

red() { printf '\033[31m%s\033[0m' "$*"; }
green() { printf '\033[32m%s\033[0m' "$*"; }
die() {
    echo "pin: $*" >&2
    exit 1
}

short() { git -C "$1" rev-parse --short "$2"; }
dirty() { [[ -n "$(git -C "$1" status --porcelain)" ]]; }

# where REPO SHA HEAD: how SHA stands to REPO's HEAD.
where() {
    local repo=$1 sha=$2
    local head
    head="$(git -C "$repo" rev-parse HEAD)"
    if [[ $sha == "$head" ]]; then
        green "at its HEAD"
    elif ! git -C "$repo" cat-file -e "$sha^{commit}" 2>/dev/null; then
        red "a commit $repo does not have (made in the submodule? fetch it into $repo)"
    elif git -C "$repo" merge-base --is-ancestor "$sha" "$head"; then
        red "$(git -C "$repo" rev-list --count "$sha..$head") commit(s) behind its HEAD"
    else
        red "not on its HEAD's history ($(git -C "$repo" branch --show-current || true) is elsewhere)"
    fi
}

status() {
    local line consumer path checkout recorded staged actual
    for line in "${SUBMODULES[@]}"; do
        read -r consumer path checkout <<<"$line"
        recorded="$(git -C "$ROOT/$consumer" ls-tree HEAD "$path" | awk '{print $3}')"
        if [[ -z $recorded ]]; then
            printf '%-26s %s\n' "$consumer/$path" "$(red "not committed in $consumer yet")"
            continue
        fi
        staged="$(git -C "$ROOT/$consumer" ls-files -s "$path" | awk '{print $2}')"
        actual="$(git -C "$ROOT/$consumer/$path" rev-parse HEAD)"
        printf '%-26s %s  %s\n' "$consumer/$path" "$(short "$ROOT/$checkout" "$recorded" 2>/dev/null || echo "${recorded:0:7}")" "$(where "$ROOT/$checkout" "$recorded")"
        [[ $staged == "$recorded" ]] || echo "    $(red "staged: ${staged:0:7}, not committed in $consumer")"
        [[ $actual == "$staged" ]] || echo "    $(red "checked out: ${actual:0:7}, not the pin (git -C $consumer submodule update $path)")"
        dirty "$ROOT/$consumer/$path" && echo "    $(red "changes in the submodule: edit $checkout/, not $consumer/$path")"
    done
    local kira
    kira="$(sed -n 's/^kira.commit=//p' "$ROOT/marify/core.properties")"
    printf '%-26s %s  %s\n' "marify core.properties" "${kira:0:7}" "$(where "$ROOT/tpm2-kira" "$kira")"
    printf '%-26s %s\n' "go-tpm (tpm2-kira)" "$(sed -n 's/^\tgithub.com\/google\/go-tpm \(.*\)$/\1/p' "$ROOT/tpm2-kira/go.mod")"
    printf '%-26s %s\n' "go-tpm (assh's replace)" "$(sed -n 's/^replace github.com\/google\/go-tpm => //p' "$ROOT/assh/go.mod")"
    local repo
    for repo in assh tpm2-kira; do
        dirty "$ROOT/$repo" && echo "$(red "$repo/ has uncommitted changes: a pin takes its HEAD, not them")"
    done
    return 0
}

# nested DIR: the submodules of the pinned checkout in DIR (tpm2-kira's
# assh/ and tpm2-verifier/ inside the vault's tpm2-kira/), at the commits
# it records, from the workspace's checkouts of the same name - their
# remotes may not have those commits yet.
nested() {
    local dir=$1 mode sha sub
    while read -r mode _ sha sub; do
        [[ $mode == 160000 && -d $ROOT/$sub/.git ]] || continue
        git -C "$dir" submodule init -q -- "$sub" 2>/dev/null || true
        if [[ ! -e $dir/$sub/.git ]]; then
            rm -rf "${dir:?}/$sub"
            git clone -q --no-checkout "$ROOT/$sub" "$dir/$sub"
        fi
        git -C "$dir/$sub" fetch -q "$ROOT/$sub" "+refs/heads/*:refs/remotes/workspace/*"
        git -C "$dir/$sub" checkout -q --detach "$sha"
    done < <(git -C "$dir" ls-tree HEAD)
}

# pin_submodules CHECKOUT: every submodule that pins CHECKOUT to its HEAD.
pin_submodules() {
    local co=$1
    dirty "$ROOT/$co" && die "$co/ has uncommitted changes: commit them first"
    local sha line consumer path checkout
    sha="$(git -C "$ROOT/$co" rev-parse HEAD)"
    for line in "${SUBMODULES[@]}"; do
        read -r consumer path checkout <<<"$line"
        [[ $checkout == "$co" ]] || continue
        dirty "$ROOT/$consumer/$path" && die "$consumer/$path has changes of its own: move them to $co/ first"
        git -C "$ROOT/$consumer/$path" fetch -q "$ROOT/$checkout" "+refs/heads/*:refs/remotes/workspace/*"
        git -C "$ROOT/$consumer/$path" checkout -q --detach "$sha"
        nested "$ROOT/$consumer/$path"
        git -C "$ROOT/$consumer" add "$path"
        echo "$consumer: $path at $(short "$ROOT/$co" "$sha"), staged - commit it in $consumer"
    done
}

pin_kira() {
    dirty "$ROOT/tpm2-kira" && die "tpm2-kira/ has uncommitted changes: commit them first"
    pin_submodules tpm2-kira
    local sha
    sha="$(git -C "$ROOT/tpm2-kira" rev-parse HEAD)"
    sed -i "s/^kira.commit=.*/kira.commit=$sha/" "$ROOT/marify/core.properties"
    git -C "$ROOT/marify" add core.properties
    echo "marify: core.properties at tpm2-kira $(short "$ROOT/tpm2-kira" "$sha"), staged - commit it in marify"
}

case "${1:-status}" in
status) status ;;
assh) pin_submodules assh ;;
tpm2-verifier) pin_submodules tpm2-verifier ;;
tpm2-kira) pin_kira ;;
*) die "usage: pin [status | assh | tpm2-kira | tpm2-verifier]" ;;
esac

#!/usr/bin/env bash
# pin: the pins between the projects of this workspace.
#
# Each project is edited in its checkout here (assh/, kira/, ...). A
# project that uses another pins a commit of it - a submodule, or a line in
# a file - and builds its releases from exactly that commit; go.work lets
# development builds use the checkouts instead. This script shows where the
# pins stand and moves them to a checkout's HEAD. It stages; committing is
# the project's own step.
#
#   ./pin status        every pin, against the checkout it pins
#   ./pin assh          kira/assh and safearch/assh to assh's HEAD
#   ./pin kira          marify's core.properties and the vault's submodule
#                       kira/ (its core) to kira's HEAD
#   ./pin tpm2-verifier kira/tpm2-verifier (the core's EK root store)
#                       to tpm2-verifier's HEAD
#   ./pin go-uefi-slim  assh/go-uefi-slim, kira/go-uefi-slim and kira-vault/go-uefi-slim (EFI
#                       variables, Secure Boot) to go-uefi-slim's HEAD
#   ./pin go-tui-slim   assh/go-tui-slim, kira/go-tui-slim and kira-vault/go-tui-slim
#                       (the full screen, questions, secrets) to go-tui-slim's HEAD
#
# go-tpm is required in every Go module's go.mod: shown, compared - one
# version for all - and moved by hand. So are the AUR recipe's commits of
# kira's submodules, shown against its pins, set with its _tag at a release.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The submodules that pin a checkout of this workspace: "consumer path checkout".
SUBMODULES=(
    "kira assh assh"
    "safearch assh assh"
    "kira-vault kira kira"
    "kira tpm2-verifier tpm2-verifier"
    "assh go-uefi-slim go-uefi-slim"
    "kira go-uefi-slim go-uefi-slim"
    "assh go-tui-slim go-tui-slim"
    "kira go-tui-slim go-tui-slim"
    "kira-vault go-tui-slim go-tui-slim"
    "kira-vault go-uefi-slim go-uefi-slim"
)

red() { printf '\033[31m%s\033[0m' "$*"; }
green() { printf '\033[32m%s\033[0m' "$*"; }
die() {
    echo "pin: $*" >&2
    exit 1
}

short() { git -C "$1" rev-parse --short "$2"; }
dirty() { [[ -n "$(git -C "$1" status --porcelain)" ]]; }

# same_tree REPO SHA HEAD: SHA is on HEAD's history and has HEAD's tree - HEAD is a
# merge of it that adds nothing (a PR merged with a merge commit), so a pin of SHA is
# current: moving it to HEAD would change no byte, and only start the next round.
same_tree() {
    local repo=$1 sha=$2 head=$3
    git -C "$repo" cat-file -e "$sha^{commit}" 2>/dev/null &&
        git -C "$repo" merge-base --is-ancestor "$sha" "$head" &&
        [[ "$(git -C "$repo" rev-parse "$sha^{tree}")" == "$(git -C "$repo" rev-parse "$head^{tree}")" ]]
}

# where REPO SHA HEAD: how SHA stands to REPO's HEAD.
where() {
    local repo=$1 sha=$2
    local head
    head="$(git -C "$repo" rev-parse HEAD)"
    if [[ $sha == "$head" ]]; then
        green "at its HEAD"
    elif same_tree "$repo" "$sha" "$head"; then
        green "at its HEAD's tree (HEAD $(short "$repo" "$head") merges it)"
    elif ! git -C "$repo" cat-file -e "$sha^{commit}" 2>/dev/null; then
        red "a commit $repo does not have (made in the submodule? fetch it into $repo)"
    elif git -C "$repo" merge-base --is-ancestor "$sha" "$head"; then
        red "$(git -C "$repo" rev-list --count "$sha..$head") commit(s) behind its HEAD"
    else
        red "not on its HEAD's history ($(git -C "$repo" branch --show-current || true) is elsewhere)"
    fi
}

# GOTPM_MODULES are the Go modules here that require go-tpm: one version
# for all, since the core, aSSH and tpm2-verifier end up in one binary.
GOTPM_MODULES=(assh kira kira/core kira-vault tpm2-verifier)

# The AUR recipe builds from GitHub's tarballs, which leave submodules out, so
# it names each submodule's commit itself: "variable path".
AUR_PKGBUILD=kira/packaging/aur/PKGBUILD
AUR_PINS=("_assh assh" "_verifier tpm2-verifier" "_uefislim go-uefi-slim" "_tuislim go-tui-slim")

# aur_status shows the recipe's commits against the submodules kira's HEAD
# records. Nothing moves them: they are set with the recipe's _tag, at a release.
aur_status() {
    local line var path want have
    for line in "${AUR_PINS[@]}"; do
        read -r var path <<<"$line"
        have="$(sed -n "s/^$var=//p" "$ROOT/$AUR_PKGBUILD" | head -1)"
        want="$(git -C "$ROOT/kira" ls-tree HEAD "$path" | awk '{print $3}')"
        if [[ -z $have ]]; then
            printf '%-26s %s\n' "aur $var" "$(red "not in $AUR_PKGBUILD")"
        elif [[ $have == "$want" ]]; then
            printf '%-26s %s  %s\n' "aur $var" "${have:0:7}" "$(green "at kira's pin")"
        else
            printf '%-26s %s  %s\n' "aur $var" "${have:0:7}" "$(red "not kira's pin ${want:0:7}: set it with _tag, at a release")"
        fi
    done
}

# gotpm_status shows the go-tpm every module requires and warns when they
# differ.
gotpm_status() {
    local m v first="" differ=false
    for m in "${GOTPM_MODULES[@]}"; do
        v="$(sed -n 's/^[[:space:]]*github.com\/google\/go-tpm \(v[^ ]*\).*$/\1/p' "$ROOT/$m/go.mod" | head -1)"
        [[ -n $v ]] || continue
        [[ -z $first ]] && first=$v
        [[ $v == "$first" ]] || differ=true
        printf '%-26s %s\n' "go-tpm ($m)" "$v"
    done
    if $differ; then
        echo "$(red "go-tpm differs between the modules: one version for all (go get github.com/google/go-tpm@<version> in each)")"
    else
        echo "go-tpm:                    $(green "one version in every module")"
    fi
}

status() {
    local line consumer path checkout recorded staged actual
    for line in "${SUBMODULES[@]}"; do
        read -r consumer path checkout <<<"$line"
        recorded="$(git -C "$ROOT/$consumer" ls-tree HEAD "$path" | awk '{print $3}')"
        if [[ -z $recorded ]]; then
            printf '%-26s %s\n' "$consumer/$path" "$(red "not committed in $consumer yet")"
            continue
        fi
        staged="$(git -C "$ROOT/$consumer" ls-files -s "$path" | awk '{print $2}')"
        actual="$(git -C "$ROOT/$consumer/$path" rev-parse HEAD)"
        printf '%-26s %s  %s\n' "$consumer/$path" "$(short "$ROOT/$checkout" "$recorded" 2>/dev/null || echo "${recorded:0:7}")" "$(where "$ROOT/$checkout" "$recorded")"
        [[ $staged == "$recorded" ]] || echo "    $(red "staged: ${staged:0:7}, not committed in $consumer")"
        [[ $actual == "$staged" ]] || echo "    $(red "checked out: ${actual:0:7}, not the pin (git -C $consumer submodule update $path)")"
        dirty "$ROOT/$consumer/$path" && echo "    $(red "changes in the submodule: edit $checkout/, not $consumer/$path")"
    done
    local kira
    kira="$(sed -n 's/^kira.commit=//p' "$ROOT/marify/core.properties")"
    printf '%-26s %s  %s\n' "marify core.properties" "${kira:0:7}" "$(where "$ROOT/kira" "$kira")"
    aur_status
    gotpm_status
    local repo
    for repo in assh kira go-uefi-slim; do
        dirty "$ROOT/$repo" && echo "$(red "$repo/ has uncommitted changes: a pin takes its HEAD, not them")"
    done
    return 0
}

# nested DIR: the submodules of the pinned checkout in DIR (kira's
# assh/ and tpm2-verifier/ inside the vault's kira/), at the commits
# it records, from the workspace's checkouts of the same name - their
# remotes may not have those commits yet.
nested() {
    local dir=$1 mode sha sub
    while read -r mode _ sha sub; do
        [[ $mode == 160000 && -d $ROOT/$sub/.git ]] || continue
        git -C "$dir" submodule init -q -- "$sub" 2>/dev/null || true
        if [[ ! -e $dir/$sub/.git ]]; then
            rm -rf "${dir:?}/$sub"
            git clone -q --no-checkout "$ROOT/$sub" "$dir/$sub"
        fi
        git -C "$dir/$sub" fetch -q --no-recurse-submodules "$ROOT/$sub" "+refs/heads/*:refs/remotes/workspace/*"
        git -C "$dir/$sub" checkout -q --detach "$sha"
    done < <(git -C "$dir" ls-tree HEAD)
}

# pin_submodules CHECKOUT: every submodule that pins CHECKOUT to its HEAD.
pin_submodules() {
    local co=$1
    dirty "$ROOT/$co" && die "$co/ has uncommitted changes: commit them first"
    local sha line consumer path checkout
    sha="$(git -C "$ROOT/$co" rev-parse HEAD)"
    for line in "${SUBMODULES[@]}"; do
        read -r consumer path checkout <<<"$line"
        [[ $checkout == "$co" ]] || continue
        if [[ -z $(git -C "$ROOT/$consumer" ls-files -s -- "$path" 2>/dev/null) ]]; then
            echo "$consumer: no submodule $path yet, nothing to move"
            continue
        fi
        dirty "$ROOT/$consumer/$path" && die "$consumer/$path has changes of its own: move them to $co/ first"
        local recorded
        recorded="$(git -C "$ROOT/$consumer" ls-tree HEAD "$path" | awk '{print $3}')"
        if [[ -n $recorded ]] && same_tree "$ROOT/$co" "$recorded" "$sha"; then
            echo "$consumer: $path at $(short "$ROOT/$co" "$recorded"), the tree of $co's HEAD already: nothing to move"
            continue
        fi
        git -C "$ROOT/$consumer/$path" fetch -q --no-recurse-submodules "$ROOT/$checkout" "+refs/heads/*:refs/remotes/workspace/*"
        git -C "$ROOT/$consumer/$path" checkout -q --detach "$sha"
        nested "$ROOT/$consumer/$path"
        git -C "$ROOT/$consumer" add "$path"
        echo "$consumer: $path at $(short "$ROOT/$co" "$sha"), staged - commit it in $consumer"
    done
}

pin_kira() {
    dirty "$ROOT/kira" && die "kira/ has uncommitted changes: commit them first"
    pin_submodules kira
    local sha
    sha="$(git -C "$ROOT/kira" rev-parse HEAD)"
    sed -i "s/^kira.commit=.*/kira.commit=$sha/" "$ROOT/marify/core.properties"
    git -C "$ROOT/marify" add core.properties
    echo "marify: core.properties at kira $(short "$ROOT/kira" "$sha"), staged - commit it in marify"
}

case "${1:-status}" in
status) status ;;
assh) pin_submodules assh ;;
tpm2-verifier) pin_submodules tpm2-verifier ;;
go-uefi-slim) pin_submodules go-uefi-slim ;;
go-tui-slim) pin_submodules go-tui-slim ;;
kira) pin_kira ;;
*) die "usage: pin [status | assh | kira | tpm2-verifier | go-uefi-slim | go-tui-slim]" ;;
esac

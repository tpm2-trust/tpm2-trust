// The development workspace: building or testing one of these projects uses
// the others' checkouts here, so a change to aSSH reaches kira and the
// vault without a commit. Releases never use it: they build the commits the
// projects pin (GOWORK=off; ./pin status shows the pins).
go 1.26.0

use (
	./assh
	./kira
	./kira-vault
	./tpm2-verifier
	./kira/core
	./go-uefi-slim
	./go-tui-slim
)

// kira and the vault each replace the core with their own copy
// (./core, the vault's submodule ./kira/core): here both take the
// checkout.
replace github.com/tpm2-trust/kira/core v0.0.0 => ./kira/core

// tpm2-verifier, the core's EK root store: kira's submodule and, in the
// vault, that submodule's - here the checkout.
replace github.com/tpm2-trust/tpm2-verifier v0.0.0 => ./tpm2-verifier

// go-uefi-slim, EFI variables and Secure Boot: aSSH's and kira's
// submodules - here the checkout.
replace github.com/tpm2-trust/go-uefi-slim v0.0.0 => ./go-uefi-slim

// go-tui-slim, a terminal's full screen, questions and secrets: kira's and
// the vault's submodules - here the checkout.
replace github.com/tpm2-trust/go-tui-slim v0.0.0 => ./go-tui-slim

// The development workspace: building or testing one of these projects uses
// the others' checkouts here, so a change to aSSH reaches tpm2-kira and the
// vault without a commit. Releases never use it: they build the commits the
// projects pin (GOWORK=off; ./pin status shows the pins).
go 1.26.0

use (
	./assh
	./tpm2-kira
	./tpm2-kira-vault
	./tpm2-kira/core
)

// tpm2-kira and the vault each replace the core with their own copy
// (./core, the vault's submodule ./tpm2-kira/core): here both take the
// checkout.
replace github.com/mrwiora/tpm2-kira/core v0.0.0 => ./tpm2-kira/core
